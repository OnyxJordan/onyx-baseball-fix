# Discord bot token (Discord Developer Portal -> your app -> Bot -> Token)
DISCORD_BOT_TOKEN=

# Channel ID of your #support channel. Messages posted here auto-create tickets.
# Right-click the channel in Discord (with Developer Mode on) -> Copy Channel ID.
# Leave as 0 to disable auto-tickets and rely on /ticket only.
SUPPORT_CHANNEL_ID=0

# Zendesk: https://<subdomain>.zendesk.com
ZENDESK_SUBDOMAIN=
# Agent/admin email that owns the API token
ZENDESK_EMAIL=
# Zendesk Admin Center -> Apps and integrations -> Zendesk API -> API tokens
ZENDESK_API_TOKEN=

# Domain used for the synthetic requester emails Zendesk needs
# (Discord doesn't expose real emails). Any domain you control works.
REQUESTER_EMAIL_DOMAIN=discord.onyxodds.com

# Where the thread -> ticket mapping is stored (JSON file)
# TICKET_STORE_PATH=support_bridge/tickets.json
